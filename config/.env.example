# Public template only. Never put real values in this file.
# Copy to a local .env outside Git and fill it there.

# Primary provider credential.
API_KEY=YOUR_API_KEY

# Telegram gateway credential and allowlist identity.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_USER_ID=YOUR_TELEGRAM_USER_ID

# Optional future VPS destination; not used by the current Android deployment.
VPS_IP=YOUR_VPS_IP
